"Fish500 vs Ostari", "Fish500 vs Metazoa", "Metazoa vs Ostari"),
count  = c(o$AO, o$AF, o$AM, o$FO, o$FM, o$MO)
)
}))
p_bar <- ggplot(overlap_df, aes(x = reorder(genome, count), y = count, fill = pair)) +
geom_col(position = "dodge") +
coord_flip() +
scale_fill_manual(values = c(
