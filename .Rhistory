) +
theme_minimal(base_size = 11) +
theme(legend.position = "bottom")
ggsave("uce_pairwise_overlaps.pdf", p_bar, width = 10, height = 6)
ggsave("uce_pairwise_overlaps.png", p_bar, width = 10, height = 6, dpi = 150)
message("Saved: uce_pairwise_overlaps.pdf and uce_pairwise_overlaps.png")
