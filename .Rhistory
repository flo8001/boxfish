library(dplyr)
library(tidyr)
# ── Data: unique loci per genome after deduplication ─────────────────────────
# Priority order: Acanthomorphs > Ostariophysans > Fish500 > Metazoa
df <- data.frame(
genome = c(
"Spotted gar\n(GCF_000242695.1)",
"Nile tilapia\n(GCF_001858045.2)",
"American eel\n(GCF_018555375.3)",
"Pink salmon\n(GCF_021184085.1)",
"Zebrafish\n(GCF_049306965.1)",
"Tiger pufferfish\n(GCF_901000725.2)",
"Sterlet sturgeon\n(GCF_902713425.1)"
),
Acanthomorphs  = c(827,  1286, 1150, 2406, 868,  1307, 1427),
Ostariophysans = c(1790, 2447, 2798, 5330, 3535, 1977, 2607),
Fish500        = c(145,  63,   237,  265,  177,  76,   294),
Metazoa        = c(294,  392,  393,  804,  353,  339,  595)
)
# Add total and reorder by total
df <- df %>%
mutate(total = Acanthomorphs + Ostariophysans + Fish500 + Metazoa) %>%
arrange(total)
df$genome <- factor(df$genome, levels = df$genome)
# Pivot to long format
df_long <- df %>%
select(-total) %>%
pivot_longer(-genome, names_to = "probe_set", values_to = "loci") %>%
mutate(probe_set = factor(probe_set,
levels = c("Metazoa", "Fish500", "Ostariophysans", "Acanthomorphs")))
# ── Plot ──────────────────────────────────────────────────────────────────────
colors <- c(
"Acanthomorphs"  = "#378ADD",
"Ostariophysans" = "#1D9E75",
"Fish500"        = "#D85A30",
"Metazoa"        = "#7F77DD"
)
p <- ggplot(df_long, aes(x = genome, y = loci, fill = probe_set)) +
geom_col(width = 0.7) +
geom_text(
data = df,
aes(x = genome, y = total, label = scales::comma(total)),
inherit.aes = FALSE,
hjust = -0.1, size = 3.2, color = "gray40"
) +
scale_fill_manual(values = colors, name = "Probe set") +
scale_y_continuous(
labels = scales::comma,
expand = expansion(mult = c(0, 0.15))
) +
coord_flip() +
labs(
title    = "Unique UCE loci per genome after deduplication",
subtitle = "Priority: Acanthomorphs > Ostariophysans > Fish500 > Metazoa\n80% identity / 80% coverage",
x        = NULL,
y        = "Unique loci"
) +
theme_minimal(base_size = 12) +
theme(
plot.title    = element_text(face = "bold", size = 13),
plot.subtitle = element_text(size = 10, color = "gray50"),
legend.position = "bottom",
panel.grid.major.y = element_blank(),
panel.grid.minor   = element_blank(),
axis.text.y = element_text(size = 10)
)
ggsave("uce_unique_loci.pdf", p, width = 9, height = 6)
ggsave("uce_unique_loci.png", p, width = 9, height = 6, dpi = 150)
message("Saved: uce_unique_loci.pdf and uce_unique_loci.png")
