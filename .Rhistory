# UCE Probe Set Overlap Venn Diagrams
# Requires: ggvenn or VennDiagram package
# Install with: install.packages("ggvenn") or install.packages("VennDiagram")
library(ggvenn)
install.packages("ggvenn")
# UCE Probe Set Overlap Venn Diagrams
# Requires: ggvenn or VennDiagram package
# Install with: install.packages("ggvenn") or install.packages("VennDiagram")
library(ggvenn)
library(ggplot2)
# ── Data ──────────────────────────────────────────────────────────────────────
# Overlap counts from bedtools intersect across 7 representative genomes
# These are probe-level hit counts (not unique loci) at 80% identity / 80% coverage
overlaps <- list(
"Spotted gar\n(GCF_000242695.1)" = list(
AO = 95, AF = 728, AM = 2, FO = 99, FM = 0, MO = 8
),
"Sterlet sturgeon\n(GCF_902713425.1)" = list(
AO = 157, AF = 1266, AM = 5, FO = 145, FM = 3, MO = 16
),
"American eel\n(GCF_018555375.3)" = list(
AO = 111, AF = 986, AM = 5, FO = 120, FM = 3, MO = 16
),
"Zebrafish\n(GCF_049306965.1)" = list(
AO = 96, AF = 820, AM = 1, FO = 120, FM = 3, MO = 8
),
"Pink salmon\n(GCF_021184085.1)" = list(
AO = 226, AF = 1803, AM = 8, FO = 268, FM = 6, MO = 29
),
"Nile tilapia\n(GCF_001858045.2)" = list(
AO = 112, AF = 957, AM = 3, FO = 128, FM = 3, MO = 13
),
"Tiger pufferfish\n(GCF_901000725.2)" = list(
AO = 112, AF = 962, AM = 3, FO = 122, FM = 3, MO = 11
)
)
# Total loci per probe set (approximate maximums)
# Acanthomorphs ~1000 loci, Ostariophysans ~2700, Fish500 ~500, Metazoa ~272
# ── Helper: build set lists for ggvenn ────────────────────────────────────────
# ggvenn takes named lists of vectors; we simulate membership by generating
# integer IDs for each set and their intersections
make_venn_sets <- function(A_total, O_total, F_total, M_total,
AO, AF, AM, FO, FM, MO) {
# Assign unique IDs to each "exclusive" region
# This is a simulation — actual locus IDs are not tracked here
id <- 0
next_ids <- function(n) { ids <- (id + 1):(id + n); id <<- id + n; ids }
A_only  <- next_ids(max(0, A_total - AO - AF - AM))
O_only  <- next_ids(max(0, O_total - AO - FO - MO))
F_only  <- next_ids(max(0, F_total - AF - FO - FM))
M_only  <- next_ids(max(0, M_total - AM - FM - MO))
AO_ids  <- next_ids(AO)
AF_ids  <- next_ids(AF)
AM_ids  <- next_ids(AM)
FO_ids  <- next_ids(FO)
FM_ids  <- next_ids(FM)
MO_ids  <- next_ids(MO)
list(
Acanthomorphs  = c(A_only,  AO_ids, AF_ids, AM_ids),
Ostariophysans = c(O_only,  AO_ids, FO_ids, MO_ids),
Fish500        = c(F_only,  AF_ids, FO_ids, FM_ids),
Metazoa        = c(M_only,  AM_ids, FM_ids, MO_ids)
)
}
# ── Plot all 7 genomes ────────────────────────────────────────────────────────
plot_list <- list()
for (genome_name in names(overlaps)) {
o <- overlaps[[genome_name]]
sets <- make_venn_sets(
A_total = 1000, O_total = 2700, F_total = 500, M_total = 272,
AO = o$AO, AF = o$AF, AM = o$AM,
FO = o$FO, FM = o$FM, MO = o$MO
)
p <- ggvenn(
sets,
fill_color   = c("#378ADD", "#1D9E75", "#D85A30", "#7F77DD"),
fill_alpha   = 0.35,
stroke_size  = 0.5,
set_name_size = 3,
text_size    = 3
) +
ggtitle(genome_name) +
theme(
plot.title = element_text(size = 9, hjust = 0.5, face = "bold"),
plot.margin = margin(4, 4, 4, 4)
)
plot_list[[genome_name]] <- p
}
# ── Arrange and save ──────────────────────────────────────────────────────────
library(patchwork)
combined <- wrap_plots(plot_list, ncol = 2) +
plot_annotation(
title    = "UCE probe set overlaps across 7 fish genomes",
subtitle = "80% identity / 80% coverage | bedtools intersect counts",
theme    = theme(
plot.title    = element_text(size = 14, face = "bold", hjust = 0.5),
plot.subtitle = element_text(size = 10, hjust = 0.5, color = "gray40")
)
)
ggsave("uce_venn_overlaps.pdf", combined, width = 14, height = 20)
ggsave("uce_venn_overlaps.png", combined, width = 14, height = 20, dpi = 150)
message("Saved: uce_venn_overlaps.pdf and uce_venn_overlaps.png")
# ── Optional: pairwise bar chart of overlaps ──────────────────────────────────
library(tidyr)
library(dplyr)
