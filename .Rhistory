# Synonym mapping
synonyms <- list(
"Strophiurichthys robustus"    = c("Anoplocapros inermis", "Strophiurichthys robustus"),
"Rhynchostracion rhinorhynchus"= c("Ostracion rhinorhynchos", "Rhynchostracion rhinorhynchus",
"Rhynchostracion rhinorhynchos"),
"Ostracion reipublicae"        = c("Tetrosomus reipublicae", "Ostracion reipublicae"),
"Lactoria paschae"             = c("Lactoria diaphana", "Lactoria paschae"),
"Acanthostracion polygonius"   = c("Acanthostracion polygonium", "Acanthostracion polygonius"),
"Acanthostracion guineensis"   = c("Acanthostracion guineense", "Acanthostracion guineensis")
)
# Check each synonym against all three datasets
ftol_taxa   <- rownames(ostrax)
morpho_taxa <- names(morpho)
mito_taxa   <- names(name_map)  # accession-keyed, check values
mito_latin  <- unname(name_map)
cat("=== Synonym search results ===\n\n")
for(canonical in names(synonyms)) {
cat("►", canonical, "\n")
for(syn in synonyms[[canonical]]) {
in_ftol   <- any(grepl(gsub(" ", "_", syn), ftol_taxa,   ignore.case=TRUE))
in_morpho <- any(grepl(syn,                 morpho_taxa, ignore.case=TRUE))
in_mito   <- any(grepl(syn,                 mito_latin,  ignore.case=TRUE))
if(in_ftol | in_morpho | in_mito) {
cat(sprintf("  ✓ '%s' found in:%s%s%s\n", syn,
ifelse(in_ftol,   " FToL",  ""),
ifelse(in_morpho, " Morpho",""),
ifelse(in_mito,   " Mito",  "")))
} else {
cat(sprintf("  ✗ '%s' — not found\n", syn))
}
}
cat("\n")
}
# Also search NCBI for synonyms not found locally
cat("=== NCBI synonym search ===\n\n")
for(canonical in names(synonyms)) {
for(syn in synonyms[[canonical]]) {
res <- entrez_search(db="nucleotide",
term=paste0('"', syn, '"[ORGN] AND 200:20000[SLEN]'),
retmax=1)
Sys.sleep(0.34)
if(res$count > 0)
cat(sprintf("  ✓ NCBI: '%s' → %d sequences\n", syn, res$count))
}
}
