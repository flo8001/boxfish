begin mrbayes;
    set autoclose=yes nowarn=yes;
    outgroup NC_009859.1;
    lset nst=6 rates=gamma ngammacat=4;
    mcmc ngen=2000000 nchains=4 samplefreq=500 
         printfreq=500 savebrlens=yes 
         filename=boxfish_mrbayes;
    sump burnin=500;
    sumt burnin=500;
end;

